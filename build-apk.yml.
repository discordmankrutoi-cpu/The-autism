name: Build Android APK
on:
  push:
    branches: [ main ] # Сработает, когда закинешь код в ветку main

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Install Bubblewrap
        run: npm install -g @bubblewrap/cli

      - name: Build APK
        # Этот шаг создаст APK. Важно: для реального заказа 
        # нужно сначала настроить twa-manifest.json
        run: |
          bubblewrap init --manifest=https://your-github-io-link.com/manifest.json
          bubblewrap build
